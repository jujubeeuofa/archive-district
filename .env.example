# Copy this file to .env and fill in as needed.
# Only DATABASE_URL, NEXTAUTH_URL, and NEXTAUTH_SECRET are required to run the app.

# --- Required ---

# Postgres connection string. Locally this can point at a Neon dev branch
# or any local/Docker Postgres (see README "Local development"). In
# production (Vercel), this is your Neon connection string, set as a
# Vercel project env var — see README "Deploying to Vercel + Neon".
DATABASE_URL="postgresql://postgres:password@localhost:5432/archive_district"

# Base URL NextAuth uses for callbacks. Update to your deployed URL in production.
NEXTAUTH_URL="http://localhost:3000"

# Random secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# --- Optional: Stripe ---
# If STRIPE_SECRET_KEY is left blank, /api/checkout automatically falls back
# to a "demo checkout" that marks the order PAID immediately without calling
# Stripe. This lets the full purchase flow work with zero external setup.
# To enable real Stripe Checkout, create a Stripe account, grab test keys
# from the Stripe dashboard, and set both of these:
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Optional: Web Push (VAPID) ---
# If these are blank, the push-subscribe button and the admin "send test
# push" action will show a clear error instead of crashing. Generate a
# keypair with `npm run vapid:generate` (uses the web-push CLI helper),
# then paste the values here. NEXT_PUBLIC_VAPID_PUBLIC_KEY must match
# VAPID_PUBLIC_KEY exactly — it's the client-side copy exposed to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Optional: Visual match search (Google Cloud Vision) ---
# If this is blank, the "Find visual matches" button on an item's admin page
# shows a clear message instead of erroring. To enable it: create a Google
# Cloud project, enable the Vision API, create an API key restricted to the
# Vision API, and set it here. Billed per lookup by Google (Web Detection is
# roughly $1.50 per 1,000 images at time of writing) — not free, unlike the
# plain-text StockX/Grailed search links, which cost nothing.
GOOGLE_VISION_API_KEY=

# --- Optional: Appointment confirmation emails (Resend) ---
# If either of these is blank, booking a showroom appointment still works —
# it just skips sending a confirmation email. This same Resend setup also
# powers staff email alerts (see below) — to enable it: create a Resend
# account (resend.com), verify a sending domain (or use their shared
# onboarding domain while testing), grab an API key, and set both:
RESEND_API_KEY=
EMAIL_FROM="Archive District <appointments@archivedistrictaz.com>"

# --- Optional: Staff alerts (email + SMS) ---
# Notifies staff (Admin/Sales, per each person's own preferences at
# /admin — "Your alert preferences") when a client books a showroom visit,
# submits something to sell, or completes a purchase.
#
# Email alerts reuse RESEND_API_KEY / EMAIL_FROM above — nothing extra to
# set. SMS alerts require Twilio: create a Twilio account (twilio.com), buy
# or provision a phone number that can send SMS, and set all three of these
# (TWILIO_FROM_NUMBER in E.164 format, e.g. "+16025551234"). Billed per
# message by Twilio. Until these are set, SMS alerts silently do nothing —
# email alerts (and everything else) still work fine without them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
